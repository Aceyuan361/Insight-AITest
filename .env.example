# AI 模块配置（复制为 .env 或写入 ~/.insight_eye/ai_config.json）
# 环境变量优先级 > 配置文件 > 默认值

# LLM（OpenAI 兼容；通义/智谱/DeepSeek/Ollama 均提供兼容端点）
INSIGHT_EYE_AI_LLM_BASE_URL=https://api.openai.com/v1
INSIGHT_EYE_AI_LLM_API_KEY=sk-your-key-here
INSIGHT_EYE_AI_CHAT_MODEL=gpt-4o-mini

# Embedding（与 chat 同一 base_url + key）
INSIGHT_EYE_AI_EMBED_MODEL=text-embedding-3-small
INSIGHT_EYE_AI_EMBED_DIM=1536
